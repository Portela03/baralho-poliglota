<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BaralhoPoliglota.Views.SobrePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sobre">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="640">
            <Label Text="🃏 Baralho Poliglota" Style="{StaticResource Headline}" HorizontalOptions="Start" />
            <Label Text="Aprenda vocabulário traduzindo palavras, guardando no seu baralho e jogando com cartas de verdade." />

            <Label Text="APIs utilizadas" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />

            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Deck of Cards API" FontAttributes="Bold" />
                    <Label Text="Baralho e cartas do jogo · deckofcardsapi.com" FontSize="12" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="MyMemory Translation" FontAttributes="Bold" />
                    <Label Text="Tradução de palavras · mymemory.translated.net" FontSize="12" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Free Dictionary API" FontAttributes="Bold" />
                    <Label Text="Definições, fonética e áudio em inglês · dictionaryapi.dev" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Navegação" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />
            <Label Text="Flyout (menu lateral) · TabBar (Traduzir, Meu Baralho, Jogar) · Pilha (detalhe da palavra e resultado)" />

            <Label x:Name="VersaoLabel" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
