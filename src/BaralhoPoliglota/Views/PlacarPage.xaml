<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BaralhoPoliglota.Views.PlacarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:BaralhoPoliglota.Core.Models;assembly=BaralhoPoliglota.Core"
    xmlns:vm="clr-namespace:BaralhoPoliglota.ViewModels"
    x:DataType="vm:PlacarViewModel"
    Title="Placar">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <VerticalStackLayout>
                <Label Text="{Binding PartidasTexto}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Partidas" FontSize="12" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1">
                <Label Text="{Binding MelhorTexto}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Melhor" FontSize="12" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2">
                <Label Text="{Binding MediaTexto}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Média" FontSize="12" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3">
                <Label Text="{Binding TaxaTexto}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Acertos" FontSize="12" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Label Grid.Row="1" Text="Histórico" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Historico}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma partida ainda. Vá até a aba Jogar!"
                       HorizontalTextAlignment="Center" VerticalOptions="Center" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:ResultadoPartida">
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Resumo}" FontAttributes="Bold" />
                            <Label Text="{Binding Data, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
