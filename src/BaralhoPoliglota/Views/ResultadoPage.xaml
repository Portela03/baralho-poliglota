<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BaralhoPoliglota.Views.ResultadoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BaralhoPoliglota.ViewModels"
    x:DataType="vm:ResultadoViewModel"
    Title="Sessão concluída">

    <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="480" VerticalOptions="Center">
        <Label Text="Sessão concluída!" Style="{StaticResource Headline}" HorizontalOptions="Center" />

        <Label Text="{Binding Revisadas}" FontSize="72" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="avaliações feitas" HorizontalOptions="Center" />

        <Label Text="{Binding Resumo}" FontSize="18" HorizontalOptions="Center" />
        <Label Text="{Binding Erros, StringFormat='Cartas que voltaram por erro: {0}'}" HorizontalOptions="Center" />
        <Label Text="{Binding Mensagem2}" FontSize="12" HorizontalTextAlignment="Center" />

        <Button Text="Voltar" Command="{Binding VoltarCommand}" />
    </VerticalStackLayout>
</ContentPage>
