<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BaralhoPoliglota.Views.ResultadoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BaralhoPoliglota.ViewModels"
    x:DataType="vm:ResultadoViewModel"
    Title="Resultado">

    <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="480" VerticalOptions="Center">
        <Label Text="{Binding Titulo}" Style="{StaticResource Headline}" HorizontalOptions="Center" />

        <Label Text="{Binding Pontos}" FontSize="72" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="pontos" HorizontalOptions="Center" />

        <Label Text="{Binding Resumo}" FontSize="18" HorizontalOptions="Center" />
        <Label Text="{Binding MelhorSequencia, StringFormat='Melhor sequência: {0}'}" HorizontalOptions="Center" />

        <Button Text="Jogar de novo" Command="{Binding JogarNovamenteCommand}" />
        <Button Text="Voltar" Command="{Binding VoltarCommand}" BackgroundColor="Transparent"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </VerticalStackLayout>
</ContentPage>
