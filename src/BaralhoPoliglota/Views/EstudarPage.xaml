<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BaralhoPoliglota.Views.EstudarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BaralhoPoliglota.ViewModels"
    x:DataType="vm:EstudarViewModel"
    Title="Estudar">

    <ScrollView>
        <Grid Padding="20" MaximumWidthRequest="640">

            <!-- Tela inicial -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding NaoEstudando}">
                <Label Text="Revisão do dia" Style="{StaticResource Headline}" HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Padding="12" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout>
                            <Label Text="{Binding NovasTexto}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1E88E5" />
                            <Label Text="Novas" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="12" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout>
                            <Label Text="{Binding ParaHojeTexto}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#43A047" />
                            <Label Text="Para hoje" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Padding="12" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout>
                            <Label Text="{Binding MaduraTexto}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#8E24AA" />
                            <Label Text="Maduras" FontSize="12" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="{Binding TextoIntro}" HorizontalTextAlignment="Center" />

                <Button Text="{Binding TextoIniciar}" Command="{Binding IniciarCommand}" IsEnabled="{Binding PodeEstudar}" />
            </VerticalStackLayout>

            <!-- Carta -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding Estudando}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Placar}" FontSize="14" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding IdiomaFrente}" FontSize="12" FontAttributes="Bold" />
                </Grid>
                <Label Text="{Binding Contador}" FontSize="12" />

                <Border Padding="24" StrokeShape="RoundRectangle 16" MinimumHeightRequest="230">
                    <VerticalStackLayout Spacing="14" VerticalOptions="Center">
                        <Label Text="{Binding Frente}" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center" />

                        <VerticalStackLayout Spacing="10" IsVisible="{Binding Revelada}">
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                            <Label Text="{Binding Verso}" FontSize="28" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{Binding Detalhes}" FontSize="13" HorizontalTextAlignment="Center" IsVisible="{Binding TemDetalhes}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Antes de responder -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding NaoRevelada}">
                    <Entry Placeholder="Digite a tradução" Text="{Binding RespostaDigitada}"
                           ReturnCommand="{Binding VerificarCommand}" />
                    <Button Text="Responder" Command="{Binding VerificarCommand}" />
                    <Button Text="Não sei" Command="{Binding NaoSeiCommand}" BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>
                <Label Text="{Binding Aviso}" TextColor="#EF6C00" IsVisible="{Binding TemAviso}" />

                <!-- Depois de responder -->
                <Label Text="{Binding Feedback}" FontAttributes="Bold" HorizontalTextAlignment="Center" IsVisible="{Binding Revelada}" />

                <Button Text="Errei, continuar" BackgroundColor="#C62828" TextColor="White"
                        IsVisible="{Binding MostrarSoErrei}"
                        Command="{Binding AvaliarCommand}" CommandParameter="Errei" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" IsVisible="{Binding MostrarAvaliacao}">
                    <Button Text="{Binding TextoDificil}" BackgroundColor="#EF6C00" TextColor="White" FontSize="13" Padding="4,8"
                            Command="{Binding AvaliarCommand}" CommandParameter="Dificil" />
                    <Button Grid.Column="1" Text="{Binding TextoBom}" BackgroundColor="#2E7D32" TextColor="White" FontSize="13" Padding="4,8"
                            Command="{Binding AvaliarCommand}" CommandParameter="Bom" />
                    <Button Grid.Column="2" Text="{Binding TextoFacil}" BackgroundColor="#1565C0" TextColor="White" FontSize="13" Padding="4,8"
                            Command="{Binding AvaliarCommand}" CommandParameter="Facil" />
                </Grid>

                <Button Text="Encerrar estudo" Command="{Binding EncerrarCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
