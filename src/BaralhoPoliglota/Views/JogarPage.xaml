<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BaralhoPoliglota.Views.JogarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BaralhoPoliglota.ViewModels"
    x:DataType="vm:JogarViewModel"
    Title="Jogar">

    <ScrollView>
        <Grid Padding="20" MaximumWidthRequest="640">

            <!-- Tela inicial -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding NaoJogando}">
                <Label Text="Baralho Poliglota" Style="{StaticResource Headline}" HorizontalOptions="Center" />
                <Label Text="{Binding TextoIntro}" HorizontalTextAlignment="Center" />

                <Border Padding="14" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Como funciona" FontAttributes="Bold" />
                        <Label Text="♥ ♦ Cartas vermelhas: múltipla escolha" />
                        <Label Text="♠ ♣ Cartas pretas: digite a tradução" />
                        <Label Text="Valor da carta = pontos (Ás vale 11, figuras valem 10)" />
                        <Label Text="Acertos seguidos dão bônus de até +5" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Iniciar partida" Command="{Binding IniciarCommand}" IsEnabled="{Binding PodeIniciar}" />
                <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />
                <Label Text="{Binding Mensagem}" TextColor="#C62828" IsVisible="{Binding TemMensagem}" />
            </VerticalStackLayout>

            <!-- Partida -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding Jogando}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <Label Text="{Binding RodadaTexto}" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding SequenciaTexto}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding PontosTexto}" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>

                <Image Source="{Binding UrlCarta}" HeightRequest="190" Aspect="AspectFit"
                       SemanticProperties.Description="{Binding DescricaoCarta}" />
                <Label Text="{Binding DescricaoCarta}" HorizontalTextAlignment="Center" FontSize="12" />
                <Label Text="{Binding TipoTexto}" HorizontalTextAlignment="Center" FontSize="12" />

                <Label Text="{Binding Enunciado}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />

                <!-- Múltipla escolha -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding EhMultipla}"
                                     BindableLayout.ItemsSource="{Binding Opcoes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button
                                Text="{Binding .}"
                                IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:JogarViewModel}}, Path=NaoRespondida}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JogarViewModel}}, Path=ResponderOpcaoCommand}"
                                CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Digitada -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding EhDigitada}">
                    <Entry
                        Placeholder="Digite a tradução"
                        Text="{Binding RespostaDigitada}"
                        IsEnabled="{Binding NaoRespondida}"
                        ReturnCommand="{Binding ResponderDigitadaCommand}" />
                    <Button Text="Responder" Command="{Binding ResponderDigitadaCommand}"
                            IsEnabled="{Binding PodeResponderDigitada}" />
                </VerticalStackLayout>

                <Label Text="{Binding Aviso}" TextColor="#EF6C00" IsVisible="{Binding TemAviso}" />

                <!-- Feedback -->
                <Border IsVisible="{Binding Respondida}" Padding="12" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Feedback}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Button Text="{Binding TextoProxima}" Command="{Binding ProximaCommand}"
                                IsEnabled="{Binding NaoOcupado}" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" />

                <!-- Falha ao sacar carta -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding FalhaAoSacar}">
                    <Label Text="{Binding Mensagem}" TextColor="#C62828" HorizontalTextAlignment="Center" />
                    <Button Text="Tentar novamente" Command="{Binding TentarNovamenteCommand}" />
                </VerticalStackLayout>

                <Button Text="Encerrar partida" Command="{Binding DesistirCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
